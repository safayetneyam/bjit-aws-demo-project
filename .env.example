DB_HOST=db
DB_PORT=3306
DB_NAME=bjit_meals
DB_USER=bjit_app
DB_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_root_password
# For Aurora, use: ******AURORA_ENDPOINT:3306/DB_NAME
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Common Config
BACKEND_CONTAINER_PORT=4000
FRONTEND_PORT=80
CORS_ORIGIN=http://localhost
VITE_API_URL=/api

# EC2 Config
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=3306
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=4000

